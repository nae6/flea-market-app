# Docker Compose (MySQL / phpMyAdmin) credentials.
# Copy this file to `.env` and set your own values before running
# `docker compose up`. Keep these in sync with src/.env's DB_* values.
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=laravel_flea_market_db
MYSQL_USER=laravel_flea_market_user
MYSQL_PASSWORD=change_me
